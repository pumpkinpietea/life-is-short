    "Touch and hold your Home Screen, tap Edit, then Add Widget. Search for Life Is Short and choose the small or medium widget.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Home Screen, tap Edit, then Add Widget. Search for Life Is Short and choose the small or medium widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面を長押しし、「編集」から「Widgetを追加」を選びます。Life Is Shortを検索し、小または中サイズを追加してください。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan Layar Utama, ketuk Edit, lalu Tambah Widget. Cari Life Is Short dan pilih widget kecil atau sedang."
          }
        }
      }
    },
    "Your selected milestones rotate about every ten minutes. iOS manages the exact timing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selected milestones rotate about every ten minutes. iOS manages the exact timing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ目標は約10分ごとに切り替わります。実際のタイミングはiOSが管理します。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Momen pilihan Anda bergantian sekitar setiap sepuluh menit. Waktu tepatnya diatur oleh iOS."
          }
        }
      }
    },
