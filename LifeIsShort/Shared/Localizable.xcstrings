    "This is a milestone you choose, not a prediction of death. Reached milestones stop at zero.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a milestone you choose, not a prediction of death. Reached milestones stop at zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で決める目標であり、死亡時期の予測ではありません。目標に到達すると残り時間はゼロで止まります。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah momen yang Anda tentukan, bukan prediksi kematian. Hitung mundur berhenti di nol saat tujuan tercapai."
          }
        }
      }
