    "Up to three milestones rotate automatically. Hidden milestones stay saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to three milestones rotate automatically. Hidden milestones stay saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大3件の目標が自動で切り替わります。非表示の目標も保存されます。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingga tiga momen bergantian secara otomatis. Momen tersembunyi tetap tersimpan."
          }
        }
      }
    },
    "Unable to open milestones": {
