    "Save a date, choose a photo, and keep a meaningful moment close.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a date, choose a photo, and keep a meaningful moment close."
