        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標の日と写真を選んで、大切な時間を身近に。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan tanggal, pilih foto, dan dekatkan momen bermakna."
