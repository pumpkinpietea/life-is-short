    "Without a time, the countdown ends at the start of that date. The saved time zone stays the same when you travel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a time, the countdown ends at the start of that date. The saved time zone stays the same when you travel."
